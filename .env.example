# ─── Trình sửa clip Motion — biến môi trường ───────────────────────────────
# Chép file này thành `.env` (chạy ở máy), hoặc khai thẳng vào phần biến môi
# trường của nơi triển khai (Docker/Coolify — cách này SẠCH HƠN: không có file
# bí mật nào nằm trong ảnh).
#
# Biến môi trường THẮNG file `.env`. Đặt biến thành chuỗi RỖNG nghĩa là "cố ý
# không có giá trị này", không phải "chưa đặt".

# ─── Đăng nhập ────────────────────────────────────────────────────────────
# AI ĐƯỢC VÀO — khai thẳng tài khoản, ngăn nhau bằng dấu phẩy.
# Không có phần đuôi thì tự ghép MOTION_DUOI_EMAIL vào.
# Bỏ trống = quay về luật "đuôi nào cũng được" bên dưới, CHỈ nên dùng lúc chạy thử.
MOTION_TAI_KHOAN=motion11011

# Đuôi email được phép — chỉ còn tác dụng khi MOTION_TAI_KHOAN bỏ trống,
# và dùng để ghép đuôi cho những tên khai thiếu đuôi ở trên.
MOTION_DUOI_EMAIL=@matbao.com

# Mật khẩu, cất DẠNG BĂM. Sinh bằng:  npm run dat-mat-khau
# (lệnh đó ghi vào `.env`; muốn dùng biến môi trường thì chép giá trị ra đây)
# ĐỂ TRỐNG = KHÔNG HỎI MẬT KHẨU, ai có đường dẫn cũng vào sửa clip được.
MOTION_MAT_KHAU_HASH=

# Khoá ký vé đăng nhập. Để trống thì máy chủ tự sinh rồi ghi vào `.env`.
# Trong container thì PHẢI đặt ở đây — container không giữ file giữa hai lần
# khởi động, nên mỗi lần restart là mọi người bị đá ra.
# Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOTION_KHOA_PHIEN=

# ─── Gốc dự án clip ───────────────────────────────────────────────────────
# Ở máy: trỏ sang thư mục dự án clip thật.
# Trong container: Dockerfile đã đặt /app/clip, không cần khai lại.
# PROJ_ROOT=/duong/dan/toi/hosting-animatic-production

# Cổng. Ở máy mặc định 7803; trong container Dockerfile đặt 3000.
# PORT=7803
